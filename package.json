{
  "name":
    "libevm",
  "version":
    "0.0.37",
  "description":
    "Library providing useful functions to write native applications interacting with EVM-compatible blockchain networks.",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man": [
    "./man/libevm.js.1"
  ],
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "dist",
    "eslint.config.mjs",
    "libevm",
    "fs-worker.webpack.config.cjs",
    "package.json",
    "webpack.config.cjs"
  ],
  "keywords": [
    "ur",
    "themartiancompany",
    "dogeos",
    "ethereum",
    "evmfs",
    "libevm",
    "evm-toolchain"
  ],
  "homepage":
    "https://github.com/themartiancompany/libevm.js",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/libevm.js/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/libevm.js.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "brace-expansion":
      "^5.0.9",
    "crash-js-webpack":
      "^0.0.64",
    "fast-uri":
      "^4.1.2",
    "eslint":
      "^10.9.0",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "safely-serve":
      "^0.0.16",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^10000000001.1000000000000001.1000000000000001",
    "evm-chains-info":
      "^0.0.34",
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.81",
    "ws":
      "^8.21.0",
    "yargs":
      "18.0.0"
  },
  "overrides": {
    "evm-chains-info":
      "^0.0.34",
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.81",
    "libevm":
      "./libevm"
  },
  "type":
    "module",
  "main":
    "libevm",
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && mkdir -p 'dist' && cp 'fs-worker.js' 'dist/libevm'",
    "build-lib":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && mv 'libevm.js' 'dist/libevm'",
    "build":
      "npm run lint && npm run build-fs-worker && npm run build-lib",
    "lint":
      "npx eslint .",
    "publish-pnm":
      "npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/libevm'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
