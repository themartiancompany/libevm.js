function
  _qr_support_check(
    _qr_support) {
  let
    _msg,
    _qr_support_get;
  const
    _qr_support_type =
      typeof(
        _qr_support);
  _qr_support_get =
    false;
  if ( _qr_support_type === "undefined" ) {
    _msg =
      "Quantum Resistance support undefined, " +
      "auto-detecting.";
    _msg_info(
      _msg);
    _qr_support_get =
      true;
  }
  else if ( _qr_support_type === "string" ) {
    if (_qr_support.length < 1 ) {
      _msg =
        "Quantum Resistance support not set, " +
        "auto-detecting.";
      _msg_info(
        _msg);
      _qr_support_get =
        true;
    }
    else {
      if ( _qr_support !== "n" &&
           _qr_support !== "y" ) {
      _msg =
        "Quantum Resistance '_qr_support' " +
        "variable can only be 'y' or 'n', " +
        `(current value '${_qr_support}').`;
      _msg_error(
        _msg,
        0);
      throw _msg;
      }
      else {
        _msg =
          "Quantum support is " +
          `'${_qr_support}'.`;
        _msg_info(
          _msg);
      }
    }
  }
  else {
    _msg =
      "Unknown type " +
      `'${_qr_support_type}' for ` +
      `variable '_qr_support':`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _qr_support_get ) {
    _qr_support =
      "n";
    _msg =
      "Set Quantum Support to " +
      `'${_qr_support}'.`;
    _msg_info(
      _msg);
  }
  return _qr_support;
}

function
  _wallet_path_get(
    _wallet_app,
    _wallet_name,
    _qr_support) {
  let
    _wallet_app_get,
    _wallet_dir,
    _wallet_name_get;
  _wallet_app =
    _wallet_app_check(
      _wallet_app);
  _wallet_name =
    _wallet_name_check(
      _wallet_name);
  _qr_support =
    _qr_support_check(
      _qr_support);
  const
    _home =
      _homedir_get();
  _wallet_dir =
    _path_join( [
      _home,
      ".config",
      _wallet_app ]);
  if ( _qr_support == "y" ) {
    _wallet_dir =
      _path_join( [
        _wallet_dir,
        "qr" ]);
  }
  const
    _path =
      _path_join( [
        _wallet_dir,
        `${_wallet_name}.dat` ]);
  const
    _msg =
      "Wallet path is " +
      `'${_path}'`;
  _msg_info(
    _msg);
  return _path;
}

function
  _secret_path_get(
    _secret,
    _app,
    _wallet_name,
    _qr_support){
  let
    _config_dir;
  if ( typeof(
         _secret) == "undefined" ||
       _secret == "" ) {
    _secret =
      "seed";
  }
  if ( typeof(
         _app) == "undefined" ||
       _app == "" ) {
    _app =
      "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
    _wallet_name =
      "default";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
    _qr_support =
      "n";
  }
  _config_dir =
    _path_join( [
      _homedir_get(),
      ".config",
      _app ]);
  if ( _qr_support == "y" ) {
    _config_dir =
      _path_join( [
        _config_dir,
        "qr" ]);
  }
  const
    _secret_path =
      _path_join( [
        _config_dir,
        `${_wallet_name}-${_secret}.txt` ]);
  return _secret_path;
}

