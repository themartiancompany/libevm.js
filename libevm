function
  _address_sanity_check(
    _address){
  let
    _error,
    _msg;
  const
    _address_type =
      typeof(
        _address);
  _error =
    false;
  if ( _address_type == "undefined" ) {
    _msg =
      `Undefined address.`;
    _error =
      true;
  }
  else if ( _address_type == "number" ) {
    _msg =
      `Invalid 'number' type for address.`;
    _error =
      true;
  }
  else if ( _address_type == "string" ) {
    if ( ! _address.startsWith(
             "0x") ) {
      _msg =
        `Malformed address '${_address}'.`;
      _error =
        true;
    }
  }
  if ( _error ) {
    _msg_error(
      _msg,
      1);
  }
}

async function
  _target_network_check(
    _target_network) {
  let
    _msg,
    _target_network_get,
    _target_network_not_number,
    _target_network_starts_with,
    _target_network_type,
    _rpcs;
  _target_network_type =
    typeof(
      _target_network);
  _target_network_get =
    false;
  if ( _target_network_type === "undefined" ) {
    _msg =
      "Target network undefined, setting default " +
      "(chain ID 1).";
    _msg_info(
      _msg);
    _target_network_get =
      true;
  }
  else if ( _target_network_type === "number" ||
            _target_network_type === "bigint" ) {
    _msg =
      "Target network " +
      `'${_target_network}' is a ` +
      "Chain ID.";
    _msg_info(
      _msg);
    _target_network_get =
      true;
  }
  else if ( _target_network_type === "string" ) {
    if ( _target_network.length < 1 ) {
      _msg =
        "Target network undefined, setting default " +
        "(chain ID 1).";
      _msg_info(
        _msg);
      _target_network_get =
        true;
      }
    else {
      if ( _target_network.startsWith(
             "http") ) {
        _msg =
          "Selected target network is " +
          `'${_target_network}'.`;
        _msg_info(
          _msg);
      }
      else {
        _target_network_not_number =
          Number(
            _target_network);
        if ( ! ( _target_network_not_number < 0 ) &&
             ! ( _target_network_not_number == 0 ) &&
             ! ( _target_network_not_number > 0 ) ) {
          _msg =
            `Target network '${_target_network}' ` +
            "is not an URL " +
            "not a Chain ID.";
          _msg_error(
            _msg,
            0);
          throw _msg;
        }
        else {
          _msg =
            "Target network " +
            `'${_target_network}' is a ` +
            "Chain ID.";
          _msg_info(
            _msg);
          _target_network_get =
            true;
        }
      }
    }
  }
  else {
    _msg =
      "Unknown type " +
      `'${_target_network_type}' ` +
      "for variable '_target_network'.";
    _msg_error(
      _msg);
    _echo2(
      _target_network);
    throw _msg;
  }
  if ( _target_network_get ) {
    const
      _target_networks = [
        _target_network
      ];
    const
      _rpc_get_args = [
        _target_networks
      ];
    try {
      _rpcs =
        await _rpc_get.apply(
          null,
          _rpc_get_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_rpc_get' with" +
        "arguments:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _error);
      throw _error;
    }
    _target_network =
      _rpcs[
        _target_network];
    _msg_info(
      _rpcs);
    _target_network_type =
      typeof(
        _target_network);
    if ( _target_network_type === "array" ) {
      _msg =
        "Retrieved target network " +
        "is an array, fixing.";
      _msg_info(
        _msg);
      _target_network =
        _target_network[
        0];
    }
    else if ( _target_network_type === "object" ) {
      if ( 0 in _target_network ) {
        _msg =
          "Retrieved target network " +
          "is an object, fixing.";
        _msg_info(
          _msg);
        _target_network =
          _target_network[
          0];
      }
      else {
        _msg =
          "Unknown object type for target network:";
        _msg_error(
          _msg,
          0);
        _echo2(
          _target_network);
        throw _msg;
      }
    }
    else if ( _target_network_type === "string" ) {
      _msg =
        `Target network is '${_target_network}'`;
      _msg_info(
        _msg);
    }
    else {
      _msg =
        "Unknown object type " +
        `'${_target_network_type}' ` +
        `for target network:`;
      _msg_error(
        _msg,
        0);
      _echo2(
        _target_network);
      throw _msg;
    }
  }
  return _target_network;
}

async function
  _evm_contracts_tools_check(
    _evm_contracts_tools) {
  let
    _import,
    _msg;
  _import =
    false;
  const
    _evm_contracts_tools_type =
      typeof(
        _evm_contracts_tools);
  if ( _evm_contracts_tools_type === "undefined" ) {
    _msg =
      "Function '_evm_contracts_tools' " +
      "undefined, importing.";
    _import =
      true;
  }
  else if ( _evm_contracts_tools_type === "string" ) {
    if ( _evm_contracts_tools.length < 1 ) {
      _msg =
        "Function '_evm_contracts_tools' " +
        "is an empty string, importing.";
      _import =
        true;
    }
    else {
      _msg =
        "Module '_evm_contracts_tools' " +
        "is a string.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else if ( _evm_contracts_tools_type === "object" ) {
    const
      _evm_contracts_tools_keys =
        Object.keys(
          _evm_contracts_tools);
    if ( _evm_contracts_tools_keys.length < 1 ) {
      _msg =
        "Module '_evm_contracts_tools' " +
        "is an empty object, importing.";
      _import =
        true;
    }
  }
  if ( _import ) {
    try {
      const
