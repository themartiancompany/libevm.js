  else {
    _msg =
      `Unknown type '${_contracts_package_module_type}' ` +
      `for contracts package module ` +
      `'${_contracts_package_module}' corresponding ` +
      `to module '${_contracts_package}'.`;
    _msg_error(
      _msg,
      0);
    _echo2(
      _contracts_package_module);
    throw _msg;
  }
  if ( _contracts_package_module_get ) {
     const
      _contracts_package_check_args = [
        _contracts_package,
        _app
      ];
    try {
      _contracts_package =
        await _contracts_package_check.apply(
          null,
          _contracts_package_check_args);
