function
  _wallet_app_check(
    _wallet_app) {
  let
    _msg,
    _wallet_app_get;
  const
    _wallet_app_type =
      typeof(
        _wallet_app);
  _wallet_app_get =
    false;
  if ( _wallet_app_type === "undefined" ) {
    _msg =
      "Wallet application undefined, auto-detecting.";
    _msg_info(
      _msg);
    _wallet_app_get =
      true;
  }
  else if ( _wallet_app_type === "string" ) {
    if (_wallet_app.length < 1 ) {
      _msg =
        "Wallet application not set, auto-detecting.";
      _msg_info(
        _msg);
      _wallet_app_get =
        true;
    }
    else {
      _msg =
        "Wallet application is " +
        `'${_wallet_app}'.`;
      _msg_info(
        _msg);
    }
  }
  else {
    _msg =
      "Unknown type " +
      `'${_wallet_app_type}' for ` +
      `variable '_wallet_app':`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _wallet_app_get ) {
    _wallet_app =
      "evm-wallet";
    _msg =
      "Set wallet application " +
      `'${_wallet_app}'.`;
    _msg_info(
      _msg);
  }
  return _wallet_app;
}

