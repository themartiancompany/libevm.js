async function
  _contracts_package_check(
    _contracts_package,
    _app) {
  let
    _contracts_package_get,
    _evm_contracts_tools,
    _msg;
  _contracts_package_get =
    false;
  const
    _contracts_package_type =
      typeof(
        _contracts_package);
  if ( _contracts_package_type === "undefined" ) {
    _msg =
      "Contracts package undefined, auto-detecting.";
    _msg_info(
      _msg);
    _contracts_package_get =
      true;
  }
  else if ( _contracts_package_type === "string" ) {
    if ( _contracts_package.length < 1 ) {
      _msg =
        "Contracts package undefined, auto-detecting.";
      _msg_info(
        _msg);
      _contracts_package_get =
        true;
    }
  }
  else {
    _msg =
      `Unknown type '${_contracts_package_type}' ` +
      "for variable '_contracts_package' (correct " +
      "type 'string').";
    _msg_error(
      _msg,
      0);
    _echo2(
      _msg);
    throw _msg;
  }
  if ( _contracts_package_get ) {
    try {
      _evm_contracts_tools =
        _get(
          "_evm_contracts",
          "tools");
      _evm_contracts_tools =
        await _evm_contracts_tools_check(
          _evm_contracts_tools);
    }
    catch(
      _error) {
      _msg =
        "Error running '_evm_contracts_tools_check' " +
        "with arguments:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _evm_contracts_tools);
      _echo2(
        _error);
      throw _error;
    }
    const
      _app_type =
        typeof(
          _app);
    if ( _app_type === "string" ) {
      if ( 0 < _app.length ) {
        const
          _app_check =
            _evm_contracts_tools._app_check;
        _app =
          _app_check(
            _app);
        try {
          const
            _module =
              await _require(
                `${_app}-contracts`);
        }
        catch(
          _error) {
          _msg =
            `Found no '${_app}-contracts' module`;
          _msg_error(
            _msg,
            0);
          _echo2(
            _error);
          throw _error;
        }
        _contracts_package =
          `${_app}-contracts`;
      }
    }
  }
  return _contracts_package;
}

async function
  _contracts_package_module_check(
    _contracts_package_module,
    _contracts_package,
