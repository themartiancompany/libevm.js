async function
  _wallet_overrides_set(
    _wallet_app,
    _wallet_name,
    _call_auth,
    _qr_support,
    _target_networks) {
  let
    _msg,
    _rpc_results,
    _rpcs,
    _target_network,
    _wallet_address,
    _wallet_seed,
    _wallet_password,
    _wallet_path;
  _msg =
    "Wallet credentials override " +
    "function.";
  _msg_info(
    _msg);
  _wallet_seed =
    "";
  const
    _global =
      _global_get();
  if ( typeof(
         _wallet_app) == "undefined" ||
       _wallet_app == "" ) {
      _wallet_app =
        "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
      _wallet_name =
        "default";
  }
  if ( typeof(
         _call_auth) == "undefined" ||
       _call_auth == "" ) {
      _call_auth =
        "y";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
      _qr_support =
        "n";
  }
  if ( typeof(
         _target_networks) == "undefined" ||
       _target_networks == "" ) {
      _target_networks = [
        1
      ];
  }
  _wallet_address =
    "";
  if ( _call_auth == "y" ) {
    // undefined
    _msg =
      "Enabled call authentication.";
    _msg_info(
      _msg);
    _wallet_path =
      _wallet_path_get(
        _wallet_app,
        _wallet_name,
        _qr_support);
    _wallet_seed =
      _secret_get(
        "seed",
        "seed",
        _wallet_app,
        _wallet_name,
        _qr_support);
    _wallet_password =
      _secret_get(
        "password",
        "plain",
        _wallet_app,
        _wallet_name,
        _qr_support);
    _target_network =
      _target_networks[
        0];
    try {
      _target_network =
        await _target_network_check(
          _target_network);
    }
    catch(
      _error) {
      _msg =
        "Error running '_target_network_check' " +
        "with parameters:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _target_network);
      _echo2(
        _error);
      throw _error;
    }
    _wallet_address =
      _get(
        "wallet",
        "address");
    const
      _wallet_address_check_args = [
        _wallet_address,
        _wallet_seed,
        _target_network,
        "",             // _api_key,
        "",             // _chain_id,
        "",             // _chain_name,
        "",             // _output_file
      ];
    try {
      _wallet_address =
        await _wallet_address_check.apply(
          null,
          _wallet_address_check_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_wallet_address_check'" +
        "with parameters:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _wallet_address_check_args);
      _echo2(
        _error);
      throw _error;
    }
  }
  else if ( _call_auth == "n" ) {
    _msg =
      "Call authentication disabled.";
    _msg_info(
      _msg);
    if ( typeof(
           wallet_seed) == "undefined" ) {
      wallet_seed =
        "";
    }
    if ( typeof(
           wallet_password) == "undefined" ) {
      wallet_password =
        "";
    }
  }
  if ( typeof(
         wallet_name) == "undefined" ||
       wallet_name == "" ) {
    _set(
      "wallet",
      "name",
      _wallet_name);
  }
  if ( typeof(
         wallet_path) == "undefined" ||
       wallet_path == "" ) {
    _set(
      "wallet",
      "path",
      _wallet_path);
  }
  if ( typeof(
         wallet_address) == "undefined" ||
       wallet_address == "" ) {
    _set(
      "wallet",
      "address",
      _wallet_address);
  }
  if ( typeof(
         wallet_seed) == "undefined" ||
       wallet_seed == "" ||
       wallet_seed == [] ) {
    _set(
      "wallet",
      "seed",
      _wallet_seed);
  }
  _msg =
    "Wallet credentials override " +
    "function finished running.";
  _msg_info(
    _msg);
  return true;
}

async function
  _rpc_get(
    _target_networks) {
  let
    _evm_chains_info_args,
    _info_retrieve,
    _msg,
    _network,
    _network_type,
    _rpc;
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  const
    _rpc_results =
      {};
  _rpc =
    {};
  _msg =
    `Getting RPCs for networks ` +
    `'${_target_networks}'.`;
  _msg_info(
    _msg);
  for ( _network of _target_networks ) {
    _network_type =
      typeof(
        _network);
    if ( _network_type == "string" ) {
      if ( _network.startsWith(
             "https://") ) {
        _rpc_results[
          _network] =
            [];
        _rpc_results[
          _network].push(
            _network);
        _info_retrieve =
          "n";
      }
      else {
        _msg =
          `Network is the string ` +
          `'${_network}', ` +
          `retrieving info.`;
        _msg_info(
          _msg);
        _info_retrieve =
          "y";
      }
    }
    else if ( _network_type == "number" ) {
      _msg =
        `Network is the number '${_network}', ` +
        `retrieving info.`;
      _msg_info(
        _msg);
      _info_retrieve =
        "y";
    }
    else {
      _msg =
        `Unknown type '${_network_type}' ` +
        `for network variable.`;
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    if ( _info_retrieve == "y" ) {
      _evm_chains_info_args = [
        "get",            // command
        "id",             // input type 
        "rpc",            // output type
        "offline",        // retrieval method
        [ "node",         // db types
          "system" ],
        "kirsh",          // selection method
        "n",              // api key
        "n",              // all networks
        _network,
        [],               // db paths
        "n"
      ];
      _msg =
        "Running '_evm_chains_info' " +
        `with arguments:`;
      _msg_info(
        _msg);
      if ( _quiet != "y" ) {
        _echo(
          _evm_chains_info_args);
      }
      try {
        _rpc_results[
          _network] =
          await _evm_chains_info.apply(
            null,
            _evm_chains_info_args);
      }
      catch(
        _error) {
        _msg =
          "Error running '_evm_chains_info' " +
          "with parameters:";
        _msg_error(
          _msg,
          0);
        _echo2(
          _evm_chains_info_args);
        throw _error;
      }
      _rpc =
        _rpc_results[
          0];
    }
  }
  _msg =
    `Obtained RPCs`;
  _msg_info(
    _msg);
  if ( _quiet != "y" ) {
    _echo(
      _rpc_results);
  }
  return _rpc_results;
}

