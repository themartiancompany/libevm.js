function
  _user_level_check(
    _user_level) {
  let
    _msg,
    _user_level_set;
  const
    _default =
      "n";
  _user_level_set =
    false;
  const
    _user_level_type =
      typeof(
        _user_level);
  if ( _user_level_type === "undefined" ) {
    _msg =
      "User-level variable is undefined, " +
      "setting default ('n').";
    _msg_info(
      _msg);
    _user_level_set =
      true;
  }
  else if ( _user_level_type === "string" ) {
    if ( _user_level.length < 1 ) {
      _user_level_set =
        true;
      _msg =
        "User-level variable is an empty " +
        "string, setting default ('n').";
      _msg_info(
        _msg);
    }
  }
  else {
    _msg =
      `Unknown value '${_user_level}' ` +
      "for variable 'user_level'.";
    _msg_info(
      _msg);
  }
  if ( _user_level_set ) {
    _user_level =
      _default;
  }
  return _user_level;
}

