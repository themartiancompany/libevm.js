/* eslint-disable
     no-unused-vars */
const
  _libcrash =
    require(
      'crash-js');
/* global
     _path_join */
/* eslint-disable-next-line
     no-global-assign */
_path_join =
  _libcrash._path_join;
const
  _evm_chains_info_module =
    require(
      'evm-chains-info');
/* global
     _evm_chains_db_path_get */
/* eslint-disable-next-line
     no-global-assign */
_evm_chains_db_path_get =
  _evm_chains_info_module._evm_chains_db_path_get;
/* global
     _rpc_backend_get */
/* eslint-disable-next-line
     no-global-assign */
_rpc_backend_get =
  _evm_chains_info_module._rpc_backend_get;
/* global
     _evm_chain_info_get */
/* eslint-disable-next-line
     no-global-assign */
_evm_chain_info_get =
  _evm_chains_info_module._evm_chain_info_get;
const
  _evm_wallet_module =
    require(
      "evm-wallet.js");
const
  _address_get =
    _evm_wallet_module._address_get;


function
  _libevm_global_variables() {
  /* global
       call_auth:
         writable */
  call_auth =
    "";
  /* global
       wallet_name:
         writable */
  wallet_name =
    "";
  /* global
       wallet_path:
         writable */
  wallet_path =
    "";
  /* global
       wallet_password:
         writable */
  wallet_password =
    "";
  /* global
       wallet_address:
         writable */
  wallet_address =
    "";
  /* global
       wallet_seed:
         writable */
  wallet_seed =
    "";
  /* global
       api_key:
         writable */
  api_key =
    "";
  /* global
       networks_amount:
         writable */
  networks_amount =
    "";
  /* global
       target_network:
         writable */
  target_network =
    "";
  /* global
       target_networks:
         writable */
  target_networks =
    [];
  /* global
       rpc_selection:
         writable */
  rpc_selection =
    "";
  /* global
       retries_max:
         writable */
  retries_max =
    "";
  /* global
       call_timeout:
         writable */
  call_timeout =
    "";
  /* global
       msg_value:
         writable */
  msg_value =
    "";
}

function
  _libevm_app_global_variables() {
  /* global
       deployments_dir:
         writable */
  deployments_dir =
    "";
  /* global
       user_level:
         writable */
  user_level =
    "";
}

function
  _contract_abi_get(
    _deployments_dir,
    _contract_name,
    _network_chain_id,
    _version) {
  const
    _file_name =
      _contract_name.concat(
        ".abi.json");
  const
    _path =
      _path_join( [
        _deployments_dir,
        _contract_name,
        _network_chain_id,
        _version,
        _file_name
      ]);
  return _path;
}

function
  _contract_bytecode_get(
    _deployments_dir,
    _contract_name,
    _network_chain_id,
    _version) {
  const
    _file_name =
      _contract_name.concat(
        ".bin");
  const
    _path =
      _path_join(
        [_deployments_dir,
         _contract_name,
         _network_chain_id,
         _version,
         _file_name]);
  return _path;
}

function
  _contract_compiler_output_get(
    _deployments_dir,
    _contract_name,
    _network_chain_id,
    _version) {
  const
    _file_name =
      _contract_name.concat(
        ".json");
  const
    _path =
      _path_join(
        [_deployments_dir,
         _contract_name,
         _network_chain_id,
         _version,
         _file_name]);
  return _path;
}

function
  _libevm_cmdline_parse(
    _argv) {
  if ( "w" in _argv ) {
    /* global
         wallet_path */
    /* eslint-disable-next-line
         no-global-assign */
    wallet_path =
      _argv[
        "w"];
  }
  if ( "wallet-path" in _argv ) {
    /* eslint-disable-next-line
         no-global-assign */
    wallet_path =
      _argv[
        "wallet-path"];
  }
  if ( "p" in _argv ) {
    /* global
         wallet_password */
    /* eslint-disable-next-line
         no-global-assign */
    wallet_password =
      _argv[
        "p"];
  }
  if ( "wallet-password" in _argv ) {
    /* eslint-disable-next-line
         no-global-assign */
    wallet_path =
      _argv[
        "wallet-password"];
  }
  if ( "s" in _argv ) {
    /* global
         wallet_seed */
    /* eslint-disable-next-line
         no-global-assign */
    wallet_seed =
      _argv[
        "s"];
  }
  if ( "wallet-seed" in _argv ) {
    /* eslint-disable-next-line
         no-global-assign */
    wallet_seed =
      _argv[
        "wallet-seed"];
  }
  if ( "k" in _argv ) {
    /* global
         api_key */
    /* eslint-disable-next-line
         no-global-assign */
    api_key =
      _argv[
        "k"];
  }
  if ( "api-key" in _argv ) {
    /* eslint-disable-next-line
         no-global-assign */
    api_key =
      _argv[
        "api-key"];
  }
  if ( "n" in _argv ) {
    /* global
         target_networks */
    target_networks.push(
      _argv[
        "n"]);
  }
  if ( "network" in _argv ) {
    target_networks.push(
      _argv[
        "network"]);
  }
}

function
  _libevm_url_parse() {
  /* global
       _argv_url_get */
  /* eslint-disable-next-line
       no-global-assign */
  wallet_path =
    _argv_url_get(
      "wallet_path")[
        0];
  /* eslint-disable-next-line
       no-global-assign */
  wallet_password =
    _argv_url_get(
      "wallet_password")[
        0];
  /* eslint-disable-next-line
       no-global-assign */
  wallet_seed =
    _argv_url_get(
      "wallet_seed")[
        0];
  /* eslint-disable-next-line
       no-global-assign */
  api_key =
    _argv_url_get(
      "api_key")[
        0];
  /* eslint-disable-next-line
       no-global-assign */
  target_networks.push(
    _argv_url_get(
      "network")[
        0]);
}

function
  _wallet_overrides_set(
    _wallet_app,
    _wallet_name,
    _call_auth,
    _qr_support) {
  if ( typeof(
         _wallet_app) == "undefined" ||
       _wallet_app == "" ) {
      _wallet_app =
        "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
      _wallet_name =
        "default";
  }
  if ( typeof(
         _call_auth) == "undefined" ||
       _call_auth == "" ) {
      _call_auth =
        "y";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
      _qr_support =
        "n";
  }
  if ( _call_auth == "y" ) {
    // undefined
    _wallet_path =
      _wallet_path_get();
    _secret_auto_detect(
      "seed",
      "seed",
      _wallet_app,
      _wallet_name,
      _qr_support);
    _secret_auto_detect(
      "password",
      "plain",
      _wallet_app,
      _wallet_name,
      _qr_support);
    // _address_get
  }
  
}

module.exports = {
  _contract_abi_get:
    _contract_abi_get,
  _contract_bytecode_get:
    _contract_bytecode_get,
  _contract_compiler_output_get:
    _contract_compiler_output_get,
  _evm_chains_db_path_get:
    _evm_chains_db_path_get,
  _evm_chain_info_get:
    _evm_chain_info_get,
  _libevm_cmdline_parse:
    _libevm_cmdline_parse,
  _libevm_url_parse:
    _libevm_url_parse,
  _rpc_backend_get:
    _rpc_backend_get
};
