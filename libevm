function
  _contract_abi_get(
    _deployments_dir,
    _contract_name,
    _network_chain_id,
    _version) {
  const
    _file_name =
      _contract_name.concat(
        ".abi.json");
  const
    _path =
      _path_join( [
        _deployments_dir,
        _contract_name,
        _network_chain_id,
        _version,
        _file_name
      ]);
  return _path;
}

function
