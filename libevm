async function
  _wallet_overrides_set(
    _wallet_app,
    _wallet_name,
    _call_auth,
    _qr_support) {
  let
    _msg,
    _wallet_address,
    _wallet_seed,
    _wallet_password,
    _wallet_path;
  /* eslint-disable
       prefer-const  */
  _wallet_seed =
    "";
  if ( typeof(
         _wallet_app) == "undefined" ||
       _wallet_app == "" ) {
      _wallet_app =
        "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
      _wallet_name =
        "default";
  }
  if ( typeof(
         _call_auth) == "undefined" ||
       _call_auth == "" ) {
      _call_auth =
        "y";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
      _qr_support =
        "n";
  }
  _wallet_address =
    "";
  _msg =
    "Getting default wallets credentials paths for " +
    `app '${_wallet_app}' and wallet '${_wallet_name}'.`;
  _msg_info(
    _msg);
  if ( _call_auth == "y" ) {
    // undefined
    _wallet_path =
      _wallet_path_get(
        _wallet_app,
        _wallet_name,
        _qr_support);
    _wallet_seed =
      _secret_get(
        "seed",
        "seed",
        _wallet_app,
        _wallet_name,
        _qr_support);
    _msg =
      `Wallet seed: '${_wallet_seed}'`;
    _msg_info(
      _msg);
    _wallet_password =
      _secret_get(
        "password",
        "plain",
        _wallet_app,
        _wallet_name,
        _qr_support);
    console.log(
      "hello");
    await _address_get(
      _wallet_seed,
      "",             // _target_network,
      "",             // _api_key,
      "",             // _chain_id,
      "",             // _chain_name,
      "",             // _output_file
    );
    _wallet_address = 
       await _address_get(
         _wallet_seed,
         "",             // _target_network,
         "",             // _api_key,
         "",             // _chain_id,
         "",             // _chain_name,
         "",             // _output_file
       );
    // to be turned into _msg_debug
    _msg =
      `Wallet address: '${_wallet_address}'`;
    _msg_info(
      _msg);
  }
  else if ( _call_auth == "n" ) {
    if ( typeof(
           wallet_seed) == "undefined" ) {
      wallet_seed =
        "";
    }
    if ( typeof(
           wallet_password) == "undefined" ) {
      wallet_password =
        "";
    }
  }
  if ( typeof(
         wallet_name) == "undefined" ||
       wallet_name == "" ) {
    wallet_name =
      _wallet_name;
  }
  if ( typeof(
         wallet_path) == "undefined" ||
       wallet_path == "" ) {
    wallet_path =
      _wallet_path;
  }
  if ( typeof(
         wallet_address) == "undefined" ||
       wallet_address == "" ) {
    wallet_address =
      _wallet_address;
  }
  return true;
}

