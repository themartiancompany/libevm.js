}

function
  _wallet_path_get(
    _wallet_app,
    _wallet_name,
    _qr_support) {
  let
    _wallet_dir;
  if ( typeof(
         _wallet_app) == "undefined" ||
       _wallet_app == "" ) {
    _wallet_app =
      "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
    _wallet_name =
      "default";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
    _qr_support =
      "n";
  }
  const
    _home =
      _homedir_get();
  _wallet_dir =
    _path_join( [
      _home,
      ".config",
      _wallet_app ]);
  if ( _qr_support == "y" ) {
    _wallet_dir =
      _path_join( [
        _wallet_dir,
        "qr" ]);
  }
  const
    _path =
      _path_join( [
        _wallet_dir,
        `${_wallet_name}.dat` ]);
  return _path;
}

function
  _secret_path_get(
    _secret,
    _app,
    _wallet_name,
    _qr){
  if ( typeof(
         _secret) == "undefined" ||
       _secret == "" ) {
    _secret =
      "seed";
  }
  if ( typeof(
         _app) == "undefined" ||
       _app == "" ) {
    _app =
      "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
    _wallet_name =
      "default";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
    _qr_support =
      "n";
  }
  const
    _config_dir =
      _path_join( [
        _homedir_get(),
        ".config",
        _app ]);
  if ( _qr_support == "y" ) {
    _config_dir =
      _path_join( [
        _config_dir,
        "qr" ]);
  }
  const
    _secret_path =
      _path_join( [
        _config_dir,
        `${_wallet_name}-${_secret}.txt` ]);
  return _secret_path;
}

function
  _secret_get(
    _secret,
    _secret_type,
    _wallet_app,
    _wallet_name,
    _qr_support) {
  if ( typeof(
         _secret) == "undefined" ||
       _secret == "" ) {
    _secret =
      "seed";
  }
  if ( typeof(
         _secret) == "undefined" ||
       _secret == "" ) {
    _secret_type =
      "seed";
  }
  if ( typeof(
         _wallet_app) == "undefined" ||
       _wallet_app == "" ) {
    _wallet_app =
      "evm-wallet";
  }
  if ( typeof(
         _wallet_name) == "undefined" ||
       _wallet_name == "" ) {
    _wallet_name =
      "default";
  }
  if ( typeof(
         _qr_support) == "undefined" ||
       _qr_support == "" ) {
    _qr_support =
      "n";
  }
  _secret_path =
    _secret_path_get(
      _secret,
      _wallet_app,
      _wallet_name,
      _qr_support);
  return _secret_path;
}

function
  _libevm_cmdline_parse(
    _argv) {
  if ( "N" in _argv ) {
    wallet_name =
      _argv[
        "N"];
  }
  if ( "wallet-name" in _argv ) {
    wallet_name =
      _argv[
        "wallet-name"];
  }
  if ( "w" in _argv ) {
    wallet_path =
      _argv[
        "w"];
  }
  if ( "wallet-path" in _argv ) {
    wallet_path =
      _argv[
        "wallet-path"];
  }
  if ( "p" in _argv ) {
    wallet_password =
      _argv[
        "p"];
  }
  if ( "wallet-password" in _argv ) {
    wallet_path =
      _argv[
        "wallet-password"];
  }
  if ( "s" in _argv ) {
    wallet_seed =
      _argv[
        "s"];
  }
  if ( "wallet-seed" in _argv ) {
    wallet_seed =
      _argv[
        "wallet-seed"];
  }
  if ( "k" in _argv ) {
    api_key =
      _argv[
        "k"];
  }
  if ( "api-key" in _argv ) {
    api_key =
      _argv[
        "api-key"];
  }
  if ( "n" in _argv ) {
    target_networks.push(
      _argv[
        "n"]);
  }
  if ( "network" in _argv ) {
    target_networks.push(
      _argv[
        "network"]);
  }
}

