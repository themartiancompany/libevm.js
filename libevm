  else if ( _contracts_package_module_type === "string" ) {
    if ( _contracts_package_module.length < 1 ) {
      _msg =
        "Contracts package module " +
        `'${_contracts_package}' for ` +
        `LibEVM application '${_app}' ` +
        "contracts package module is an empty string, " +
        "initializing.";
      _msg_info(
